+	// KWOK_EXEC_PREFIX lets a node agent that runs real processes wrap the
+	// command (e.g. with nsenter into the pod's namespaces and root).
+	for _, env := range execTarget.Local.Envs {
+		if env.Name == "KWOK_EXEC_PREFIX" && env.Value != "" {
+			cmd = append(strings.Fields(env.Value), cmd...)
+		}
+	}
