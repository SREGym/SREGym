# Copy this file to .env at the repository root and fill in the values.
# .env is git-ignored. Shell exports take precedence over values here.
# Set SREGYM_ENV_FILE=/path/to/file to load a different file.

# TypeSafe (Jev) - used by the jev_diag agent
TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Anthropic (Claude) - used for e.g. --judge-model anthropic/claude-sonnet-5
ANTHROPIC_API_KEY=
# Judge defaults (the --judge-model / --judge-reasoning-effort flags override these)
# JUDGE_MODEL_ID=anthropic/claude-sonnet-5
# JUDGE_REASONING_EFFORT=medium
# JUDGE_MAX_TOKENS=16000

# Any other provider key from the README works here too, e.g.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
