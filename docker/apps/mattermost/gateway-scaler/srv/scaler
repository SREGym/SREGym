import json
import math
import os
import ssl
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from threading import Thread
CONTROL = Path(os.environ.get('CONTROL_PATH', '/control'))
POLICY = CONTROL / 'scaler.json'
DECISIONS = CONTROL / 'scaler-decisions.jsonl'
NAMESPACE = os.environ.get('NAMESPACE', 'mattermost')
TARGET = os.environ.get('SCALER_TARGET', 'chat-gateway')
INTERVAL = float(os.environ.get('SCALER_INTERVAL', '15'))
SCALE_IN_STABILIZATION_SECONDS = 45
API = 'https://kubernetes.default.svc'
SECRETS = Path('/var/run/secrets/kubernetes.io/serviceaccount')
latest = {'observed': None, 'replicas': None, 'decision': 'starting', 'metric': 'cpu'}

def token():
    return (SECRETS / 'token').read_text().strip()

def api(path, method='GET', body=None):
    request = urllib.request.Request(API + path, data=json.dumps(body).encode() if body is not None else None, method=method, headers={'Authorization': 'Bearer ' + token(), 'Accept': 'application/json', **({'Content-Type': 'application/merge-patch+json'} if body is not None else {})})
    context = ssl.create_default_context(cafile=str(SECRETS / 'ca.crt'))
    with urllib.request.urlopen(request, timeout=10, context=context) as response:
        return json.loads(response.read())

def observe(samples, metric):
    values = [s.get(metric) for s in samples]
    if not values or any((type(value) not in (int, float) or not math.isfinite(value) or value < 0 for value in values)):
        return None
    return round(sum(values) / len(values), 2)

class ScaleInStabilizer:

    def __init__(self):
        self.reset()

    def reset(self):
        self.context = None
        self.since = None

    def target(self, current, requested, pod_uids, rules):
        if requested >= current:
            self.reset()
            return requested
        context = (current, tuple(sorted(pod_uids)), dict(rules))
        now = time.monotonic()
        if context != self.context:
            self.context, self.since = (context, now)
        if now - self.since < SCALE_IN_STABILIZATION_SECONDS:
            return current
        return requested

def record(entry):
    latest.update(entry)
    with DECISIONS.open('a') as stream:
        stream.write(json.dumps({'at': time.time(), **entry}) + '\n')
import json
import math
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from threading import Thread
METRICS = {'cpu': 'cpu_percent', 'saturation': 'saturation_percent'}
DEFAULT_POLICY = {'enabled': False, 'min': 1, 'max': 12, 'scale_in': {'enabled': True, 'metric': 'cpu', 'below': 25}, 'scale_out': {'enabled': True, 'metric': 'saturation', 'above': 75, 'step': 3, 'cooldown_seconds': 60}}
fleet = {'in_service': None, 'requested': None, 'readings': {}, 'last_scale_out': None}

def policy():
    try:
        loaded = json.loads(POLICY.read_text())
    except (OSError, ValueError):
        return json.loads(json.dumps(DEFAULT_POLICY))
    merged = {**DEFAULT_POLICY, **loaded}
    for name in ('scale_in', 'scale_out'):
        merged[name] = {**DEFAULT_POLICY[name], **(loaded.get(name) or {})}
    return merged

def in_service(pods):
    ready = []
    for pod in pods:
        status = pod.get('status', {})
        if pod['metadata'].get('deletionTimestamp') or status.get('phase') != 'Running' or (not status.get('podIP')):
            continue
        if any((c.get('type') == 'Ready' and c.get('status') == 'True' for c in status.get('conditions', []))):
            ready.append(pod)
    return ready

def gateway_metrics():
    pods = api(f'/api/v1/namespaces/{NAMESPACE}/pods?labelSelector=app%3D{TARGET}')['items']
    samples = []
    for pod in in_service(pods):
        try:
            with urllib.request.urlopen(f"http://{pod['status']['podIP']}:8080/metrics", timeout=5) as response:
                samples.append({**json.loads(response.read()), 'pod_uid': pod['metadata']['uid']})
        except (OSError, ValueError, TypeError):
            continue
    return samples

def readings_from(samples):
    return {name: observe(samples, field) for name, field in METRICS.items()}

def decide(current, readings, rules, now, last_scale_out):
    low, high = (rules['min'], rules['max'])
    if current < low:
        return (low, f'{current} below policy min {low}', 'bound')
    if current > high:
        return (high, f'{current} above policy max {high}', 'bound')
    out, inward = (rules['scale_out'], rules['scale_in'])
    notes = []
    if out.get('enabled', True):
        value = readings.get(out['metric'])
        if value is not None and value > out['above']:
            if current >= high:
                notes.append(f"{out['metric']} {value}% above {out['above']}% but at max {high}")
            elif last_scale_out is not None and now - last_scale_out < out['cooldown_seconds']:
                notes.append(f"{out['metric']} {value}% above {out['above']}%, scale-out cooling down")
            else:
                added = max(out['step'], math.ceil(current * out.get('percent', 0) / 100))
                return (min(high, current + added), f"{out['metric']} {value}% above {out['above']}%", 'scale_out')
    if inward.get('enabled', True):
        value = readings.get(inward['metric'])
        if value is not None and value < inward['below']:
            if current > low:
                tracked = math.ceil(current * value / inward['below'])
                return (max(low, min(current - 1, tracked)), '; '.join([*notes, f"{inward['metric']} {value}% below {inward['below']}%"]), 'scale_in')
            notes.append(f"{inward['metric']} {value}% below {inward['below']}% but at min {low}")
    if not any((value is not None for value in readings.values())):
        notes.append('no metric available')
    return (current, '; '.join(notes) or 'within band', 'hold')
import json
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from threading import Thread

def stamp(now):
    return time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(now))

def activity(current, target, kind, rules):
    if target == current:
        return None
    count = abs(target - current)
    verb = f"Launching {count} new instance{'s' * (count != 1)}" if target > current else f"Terminating {count} instance{'s' * (count != 1)}"
    change = f'changing the desired capacity from {current} to {target}'
    if kind == 'scale_out':
        metric = rules['scale_out']['metric']
        cause = f'a monitor alarm {TARGET}-{metric}-high in state ALARM triggered policy {TARGET}-scale-out {change}'
    elif kind == 'scale_in':
        metric = rules['scale_in']['metric']
        cause = f'a monitor alarm {TARGET}-{metric}-low in state ALARM triggered policy {TARGET}-scale-in {change}'
    else:
        cause = f"the group's size limits ({rules['min']}-{rules['max']}) took effect, {change}"
    return {'activity': verb, 'cause': f'At {stamp(time.time())} {cause}.', 'status': 'Successful', 'desired_capacity': target}

def reconcile(stabilizer):
    rules = policy()
    scale_path = f'/apis/apps/v1/namespaces/{NAMESPACE}/deployments/{TARGET}/scale'
    scale = api(scale_path)
    current = scale['spec'].get('replicas', 1)
    fleet['requested'] = current
    if not rules['enabled']:
        stabilizer.reset()
        return
    samples = gateway_metrics()
    readings = readings_from(samples)
    fleet.update(in_service=len(samples), readings=readings)
    now = time.monotonic()
    requested, _, kind = decide(current, readings, rules, now, fleet['last_scale_out'])
    target = requested
    if kind == 'scale_in':
        target = stabilizer.target(current, requested, [s['pod_uid'] for s in samples], rules)
    else:
        stabilizer.reset()
    if target != current:
        api(scale_path, 'PATCH', {'metadata': {'resourceVersion': scale['metadata']['resourceVersion']}, 'spec': {'replicas': target}})
        fleet['requested'] = target
    if kind == 'scale_out':
        fleet['last_scale_out'] = now
    if (entry := activity(current, target, kind, rules)):
        record(entry)

def loop():
    stabilizer = ScaleInStabilizer()
    while True:
        try:
            reconcile(stabilizer)
        except Exception as exc:
            stabilizer.reset()
            record({'activity': 'Updating group capacity', 'cause': f'At {stamp(time.time())} a scheduled evaluation could not complete.', 'status': 'Failed', 'description': f'{type(exc).__name__}: {exc}'})
        time.sleep(INTERVAL)

class Dashboard(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'

    def log_message(self, fmt, *args):
        return

    def do_GET(self):
        if self.path in ('/dashboard', '/health'):
            code, body = (200, {'group': TARGET, 'desired_capacity': fleet['requested'], 'instances_in_service': fleet['in_service'], 'last_activity': {k: latest.get(k) for k in ('activity', 'cause', 'status')}})
        else:
            code, body = (404, {'error': 'not found'})
        payload = json.dumps(body).encode()
        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)
if __name__ == '__main__':
    CONTROL.mkdir(parents=True, exist_ok=True)
    print(f'capacity scaler group={TARGET} namespace={NAMESPACE} interval={INTERVAL}s', flush=True)
    Thread(target=loop, daemon=True).start()
    ThreadingHTTPServer(('', 8080), Dashboard).serve_forever()
