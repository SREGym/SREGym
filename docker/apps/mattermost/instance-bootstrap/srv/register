import json,os,time,urllib.request
body=json.dumps({'instance':os.environ['HOSTNAME']}).encode()
attempt=0
while True:
 attempt+=1
 try:
  request=urllib.request.Request('http://provisioner:8080/register',data=body,method='POST',headers={'Content-Type':'application/json'})
  with urllib.request.urlopen(request,timeout=3) as response:
   if response.status==200:
    print(f'registered after {attempt} attempts',flush=True);break
 except Exception as exc:
  print(f'registration attempt {attempt} failed: {exc}',flush=True)
 time.sleep(1)
