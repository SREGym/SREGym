{"spec": {"template": {"spec": {"containers": [{"image": "mongo:4.4.6", "imagePullPolicy": "IfNotPresent", "name": "hotel-reserv-profile-mongo", "ports": [{"containerPort": 27017, "protocol": "TCP"}], "resources": {"limits": {"cpu": "1"}, "requests": {"cpu": "100m"}}, "terminationMessagePath": "/dev/termination-log", "terminationMessagePolicy": "File", "volumeMounts": [{"mountPath": "/data/db", "name": "profile"}]}, {"name": "catalog-retention", "image": "mongo:4.4.6", "imagePullPolicy": "IfNotPresent", "command": ["bash", "/etc/catalog/run.sh"], "readinessProbe": {"exec": {"command": ["mongo", "--host", "127.0.0.1", "admin", "--quiet", "--eval", "if(!db.runCommand({ping:1}).ok) quit(1);"]}, "periodSeconds": 2, "timeoutSeconds": 2, "failureThreshold": 30}, "resources": {"requests": {"cpu": "10m", "memory": "32Mi"}, "limits": {"cpu": "250m", "memory": "128Mi"}}, "volumeMounts": [{"name": "catalog-retention", "mountPath": "/etc/catalog", "readOnly": true}]}], "dnsPolicy": "ClusterFirst", "hostname": "profile-db", "restartPolicy": "Always", "schedulerName": "default-scheduler", "securityContext": {}, "terminationGracePeriodSeconds": 30, "volumes": [{"name": "profile", "persistentVolumeClaim": {"claimName": "profile-pvc"}}, {"name": "catalog-retention", "configMap": {"name": "catalog-retention"}}]}}}}